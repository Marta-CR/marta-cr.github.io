{% comment %}Shared section colours for every layout, including About.{% endcomment %}
{% assign section_permalink = page.permalink | default: page.url | downcase %}
{% assign current_section = 'submenus' %}
{% case section_permalink %}
  {% when '/' %}{% assign current_section = 'about' %}
  {% when '/about/' %}{% assign current_section = 'about' %}
  {% when '/publications/' %}{% assign current_section = 'publications' %}
  {% when '/cv/' %}{% assign current_section = 'cv' %}
  {% when '/projects/' %}{% assign current_section = 'research' %}
  {% when '/research/' %}{% assign current_section = 'research' %}
  {% when '/repositories/' %}{% assign current_section = 'repositories' %}
  {% when '/teaching/' %}{% assign current_section = 'teaching' %}
  {% when '/people/' %}{% assign current_section = 'people' %}
{% endcase %}

<style>
/* Classical academic styling. System fonts keep the site self contained. */
:root, html[data-theme="light"] {
  --global-bg-color: #faf8f3;
  --global-card-bg-color: #faf8f3;
  --global-text-color: #303238;
  --global-text-color-light: #676970;
  --global-theme-color: #203b53;
  --global-hover-color: #763b46;
  --global-divider-color: #d9d5cc;
  --global-footer-bg-color: #eeebe4;
  --global-footer-text-color: #53565b;
  --global-footer-link-color: #203b53;
}
html[data-theme="dark"] {
  --global-bg-color: #20242a;
  --global-card-bg-color: #252a31;
  --global-text-color: #e7e3da;
  --global-text-color-light: #b9b6b0;
  --global-theme-color: #c3d3e0;
  --global-hover-color: #e3b7bd;
  --global-divider-color: #49515a;
  --global-footer-bg-color: #1b1f24;
  --global-footer-text-color: #b9b6b0;
  --global-footer-link-color: #c3d3e0;
}
body { background: var(--global-bg-color); color: var(--global-text-color); font-family: Arial, Helvetica, sans-serif; line-height: 1.75; }
h1, h2, h3, h4, .post-title, .navbar-brand { font-family: Georgia, 'Times New Roman', serif; letter-spacing: -.015em; font-weight: 400; color: var(--global-theme-color); }
.post-header { margin-bottom: 2.3rem; }
.post-title { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; }
.post-title .font-weight-bold { font-weight: 400 !important; }
.post-description { color: var(--global-text-color-light); font-size: 1.05rem; }
article p { margin-bottom: 1.2rem; }
article h2 { margin-top: 2.5rem; padding-bottom: .4rem; border-bottom: 1px solid var(--global-divider-color); }
article h3 { margin-top: 1.8rem; }
#navbar { background: var(--global-bg-color); opacity: 1; box-shadow: none; border-bottom: 1px solid var(--global-divider-color); }
#navbar .nav-link.section-nav-badge { display: inline-block; padding: .55rem .5rem; margin: .1rem; background: transparent; border: 0; border-radius: 0; box-shadow: none; color: var(--global-text-color); font-weight: 400; line-height: 1.4; }
#navbar .nav-item.active > .nav-link.section-nav-badge, #navbar .nav-link.section-nav-badge:hover { background: transparent; color: var(--global-theme-color); text-decoration: underline; text-underline-offset: .45em; text-decoration-thickness: 1px; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--global-hover-color); outline-offset: 4px; }
#navbar .dropdown-menu { border-radius: 0; box-shadow: none; border: 1px solid var(--global-divider-color); padding: .5rem 0; }
#navbar .dropdown-item { padding: .5rem 1.2rem; }
.profile img { border-radius: 0 !important; box-shadow: none !important; border: 1px solid var(--global-divider-color); padding: 5px; background: var(--global-card-bg-color); }
.profile .more-info { color: var(--global-text-color-light); font-size: .9rem; }
.publications ol.bibliography .abbr abbr.badge { background: transparent; color: var(--global-theme-color); border: 1px solid var(--global-divider-color); border-radius: 0; box-shadow: none; }
.publications ol.bibliography .abbr abbr.badge a { color: inherit; }
footer.fixed-bottom, footer.sticky-bottom { background: var(--global-footer-bg-color); border-top: 1px solid var(--global-divider-color); }
.resource-list { margin-top: 2rem; }
.resource-entry { display: block; padding: 1.4rem 0; border-top: 1px solid var(--global-divider-color); color: inherit; text-decoration: none; }
.resource-entry:last-child { border-bottom: 1px solid var(--global-divider-color); }
.resource-entry h2 { border: 0; padding: 0; margin: 0 0 .45rem; font-size: 1.6rem; }
.resource-entry p { margin: 0; color: var(--global-text-color-light); }
.resource-entry:hover h2 { color: var(--global-hover-color); text-decoration: underline; text-underline-offset: .2em; }
@media(max-width: 575.98px) { .post-header { margin-bottom: 1.6rem; } .profile { margin-bottom: 1.5rem; } #navbar .nav-link.section-nav-badge { margin: .1rem 0; } }

</style>

<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter d-none" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link section-nav-badge section-about" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle section-nav-badge section-submenus"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  {% assign nav_section = 'submenus' %}
                  {% assign nav_permalink = p.permalink | default: p.url | downcase %}
                  {% case nav_permalink %}
                    {% when '/' %}{% assign nav_section = 'about' %}
                    {% when '/about/' %}{% assign nav_section = 'about' %}
                    {% when '/publications/' %}{% assign nav_section = 'publications' %}
                    {% when '/cv/' %}{% assign nav_section = 'cv' %}
                    {% when '/projects/' %}{% assign nav_section = 'research' %}
                    {% when '/research/' %}{% assign nav_section = 'research' %}
                    {% when '/repositories/' %}{% assign nav_section = 'repositories' %}
                    {% when '/teaching/' %}{% assign nav_section = 'teaching' %}
                    {% when '/people/' %}{% assign nav_section = 'people' %}
                  {% endcase %}
                  <a class="nav-link section-nav-badge section-{{ nav_section }}" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
