---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign current_permalink = page.permalink | downcase %}
{% assign section_accent = '' %}
{% case current_permalink %}
  {% when '/cv/' %}
    {% assign section_accent = '#b509ac' %}
  {% when '/projects/' %}
    {% assign section_accent = '#7e3fa5' %}
  {% when '/teaching/' %}
    {% assign section_accent = '#007c83' %}
  {% when '/people/' %}
    {% assign section_accent = '#2465a0' %}
{% endcase %}

{% if section_accent != '' %}
  <style>
    /* Filled labels inspired by the journal badges on Publications. */
    .post.section-headings > .post-header > .post-title,
    .post.section-headings > article h2 {
      display: table;
      box-sizing: border-box;
      max-width: 100%;
      width: fit-content;
      padding: 0.45rem 0.85rem;
      border: 0;
      border-radius: 5px;
      background: var(--section-accent);
      color: #fff;
      box-shadow: 0 3px 9px rgba(0, 0, 0, 0.22);
      font-weight: 600;
      line-height: 1.3;
      overflow-wrap: anywhere;
    }

    .post.section-headings > .post-header > .post-title {
      margin-bottom: 0.8rem;
    }

    .post.section-headings > article h2 {
      margin-top: 2rem;
      margin-bottom: 1.1rem;
    }

    .post.section-headings > .post-header > .post-title a,
    .post.section-headings > article h2 a {
      color: inherit;
    }

    @media (max-width: 575.98px) {
      .post.section-headings > .post-header > .post-title {
        font-size: 1.8rem;
      }

      .post.section-headings > article h2 {
        padding: 0.45rem 0.7rem;
        font-size: 1.4rem;
      }
    }
  </style>
{% endif %}

<div class="post{% if section_accent != '' %} section-headings{% endif %}"{% if section_accent != '' %} style="--section-accent: {{ section_accent }};"{% endif %}>
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
