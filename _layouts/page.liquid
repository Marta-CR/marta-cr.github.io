---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign pink_heading_pages = '/cv/|/projects/|/teaching/|/people/' | split: '|' %}
{% assign current_permalink = page.permalink | downcase %}
{% assign use_pink_headings = false %}
{% if pink_heading_pages contains current_permalink %}
  {% assign use_pink_headings = true %}
  <style>
    /* Main headings on the CV, Research, Teaching, and People pages. */
    .post.pink-section-headings > .post-header > .post-title,
    .post.pink-section-headings > article h2 {
      box-sizing: border-box;
      border: 2px solid #e78aae;
      border-radius: 0;
      background-color: rgba(231, 138, 174, 0.10);
      color: var(--global-text-color, inherit);
      padding: 0.65rem 0.9rem;
      line-height: 1.3;
      overflow-wrap: break-word;
    }

    .post.pink-section-headings > article h2 {
      margin-top: 2rem;
      margin-bottom: 1rem;
    }

    html[data-theme='dark'] .post.pink-section-headings > .post-header > .post-title,
    html[data-theme='dark'] .post.pink-section-headings > article h2 {
      border-color: #ef9cbd;
      background-color: rgba(239, 156, 189, 0.10);
    }
  </style>
{% endif %}

<div class="post{% if use_pink_headings %} pink-section-headings{% endif %}">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
